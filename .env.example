# Server-only site gate password (Secret in Vercel). Do not use a VITE_ prefix.
# Not required for `npm run dev` — the site password gate is skipped in Vite development mode.
SITE_PASSWORD=your-password-here
AUTH_SECRET=replace-with-a-long-random-string

# Server-only DoD case study gate (no VITE_ prefix).
DOD_CASE_STUDY_PASSWORD=your-dod-case-study-password

# Server-only enterprise roles widget gate (no VITE_ prefix).
# Local `npm run dev` falls back to `roles` if this is unset.
ENTERPRISE_ROLES_PASSWORD=your-enterprise-roles-widget-password

# Auto-injected when a Vercel Blob store is linked to the project (analytics persistence).
BLOB_READ_WRITE_TOKEN=

# Optional local dev only — cookie signing fallback if AUTH_SECRET is unset.
VITE_AUTH_SECRET=replace-with-a-long-random-string
