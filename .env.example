SITE_PASSWORD=your-password-here
AUTH_SECRET=replace-with-a-long-random-string

# Auto-injected when a Vercel Blob store is linked to the project (analytics persistence).
BLOB_READ_WRITE_TOKEN=

# Required for Vercel builds so the password gate works even if API routes fail.
VITE_SITE_PASSWORD=your-password-here
VITE_AUTH_SECRET=replace-with-a-long-random-string
